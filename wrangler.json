{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazon-table",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "amazon-hike.com/tool23", "zone_name": "amazon-hike.com" },
    { "pattern": "amazon-hike.com/tool23/*", "zone_name": "amazon-hike.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "TRIPS_KV",
      "id": "bf33efa9b16f4861a9efef5ceeae75c7"
    }
  ]
}
