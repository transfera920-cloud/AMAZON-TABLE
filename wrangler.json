{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazon-table",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "TRIPS_KV",
      "id": "TRIPS_KV"
    }
  ]
}
